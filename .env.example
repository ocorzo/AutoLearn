# Copia este archivo como .env y sustituye únicamente los valores que apliquen
# a tu despliegue. .env está excluido de Git.
CHAAK_DOCKER_NETWORK=bigone-llm_default
LLAMA_API_BASE=http://bigone-qwen35-4b-llama-server:8080/v1
MODEL_ID=chaak

# Crea un valor único, por ejemplo con: openssl rand -hex 32
MEMORY_ADMIN_TOKEN=replace-with-a-new-random-secret

# Clave que Chatbox y los paneles /control y /activity deben enviar como
# "Authorization: Bearer <clave>". Vacía = gateway abierto (solo para una red
# de confianza). Recomendado: openssl rand -hex 32
GATEWAY_API_KEY=
# Orígenes permitidos por CORS, separados por comas (p. ej. http://chaak:3084).
CORS_ALLOW_ORIGINS=*

# Herramientas de archivos del MCP: solo lectura por defecto. Para permitir que
# el agente cree, modifique o borre archivos en runtime/allowed-data, cambia
# ambos valores a la vez: MCP_ALLOW_WRITES=true y MCP_DATA_MODE=rw.
MCP_ALLOW_WRITES=false
MCP_DATA_MODE=ro

MEMORY_ENABLED=true
MEMORY_USER_ID=ocorzo
MEMORY_AGENT_ID=chaak
MEMORY_COLLECTION=chaak_memories
MEMORY_TOP_K=4
