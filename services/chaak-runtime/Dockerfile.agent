FROM python:3.12-slim
# sentence-transformers needs PyTorch only for CPU embeddings in this gateway.
# Installing it first from the CPU index avoids pulling the full CUDA runtime.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch==2.7.1+cpu"
RUN pip install --no-cache-dir "smolagents[mcp]>=1.19,<2" "mcp>=1.9,<1.14" "openai>=1.70,<2" "mem0ai>=2.0.10,<2.1" chromadb sentence-transformers fastapi uvicorn
WORKDIR /app
COPY agent_runner.py .
COPY app_server.py .
COPY memory_service.py .
CMD ["uvicorn", "app_server:app", "--host", "0.0.0.0", "--port", "8090"]
